APP_ENV=development
PORT=5001

# Database Configuration (MariaDB / MySQL - Host mapped to 3307, inside Docker 3306)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=kelolakerja_db
DB_USER=root
DB_PASS=root

# Caching & Session
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Security & Biometric Threshold (ResNet-34 128-D)
TOKEN_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter-di-produksi
TOKEN_TTL=86400
FACE_THRESHOLD=0.42
